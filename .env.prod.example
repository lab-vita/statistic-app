# Скопировать в .env на сервере: cp .env.prod.example .env && chmod 600 .env
# Пароль генерировать только hex (без спецсимволов, он попадает в URL): openssl rand -hex 24
POSTGRES_PASSWORD=

DOMAIN=docs.lab-vita.ru

# Битрикс24: вебхук для сбора звонков (права: telephony)
BITRIX_WEBHOOK_URL=https://ПОРТАЛ.bitrix24.ru/rest/ID/ТОКЕН/

# МедОДС
MEDODS_URL=https://labvita.medods.ru
MEDODS_USERNAME=
MEDODS_PASSWORD=
MEDODS_CLINIC_ID=1

# --- Вход через Битрикс24 ---
# Домен портала БЕЗ https://
BITRIX_PORTAL_DOMAIN=mfk-sfera.bitrix24.ru
# Секрет подписи токенов: openssl rand -hex 32
SESSION_SECRET=
# Ваш ID в Битрикс24 (число из адреса профиля /company/personal/user/ЧИСЛО/).
# При первом входе этому пользователю автоматически создаётся запись владельца.
OWNER_BITRIX_USER_ID=
