# Скопировать в .env на сервере: cp .env.prod.example .env && chmod 600 .env
# Пароль генерировать только hex (без спецсимволов, он попадает в URL): openssl rand -hex 24
POSTGRES_PASSWORD=

DOMAIN=docs.lab-vita.ru

# Битрикс24: вебхук для сбора звонков (права: telephony)
BITRIX_WEBHOOK_URL=https://ПОРТАЛ.bitrix24.ru/rest/ID/ТОКЕН/

# МедОДС
MEDODS_URL=https://labvita.medods.ru
MEDODS_USERNAME=
MEDODS_PASSWORD=
MEDODS_CLINIC_ID=1

# Понадобится на этапе авторизации (пока не используется)
BITRIX_PORTAL_DOMAIN=ПОРТАЛ.bitrix24.ru
SESSION_SECRET=
