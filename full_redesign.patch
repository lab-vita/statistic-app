+}
+
+function convColor(pct: number) {
+  return pct >= 70 ? "text-emerald-600 dark:text-emerald-400"
+       : pct >= 40 ? "text-amber-600 dark:text-amber-400"
+       : "text-red-600 dark:text-red-400";
+}
