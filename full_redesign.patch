-  function snapDrop(id:string, dx:number, dy:number) {
-    const cp=cpx(), pw=widgets.find(w=>w.id===id);
-    if (!cp||!pw||!rowH) return null;
-    const nx=Math.min(Math.max(pw.x+Math.round(dx/(cp+GAP)),0),COLS-pw.w);
