+import { ROLE_LABELS, type Section } from "@/lib/permissions";
+import { cn } from "@/lib/utils";
+
+export type { Section };
+
+const NAV: { id: Section; label: string; icon: React.ElementType }[] = [
+  { id: "home",         label: "Главная",  icon: LayoutDashboard },
