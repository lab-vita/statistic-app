+@import "tailwindcss";
+@import "tw-animate-css";
+@import "shadcn/tailwind.css";
+
+@theme inline {
+  --font-sans: var(--font-montserrat);
+  --font-mono: var(--font-geist-mono);
+
+  --color-background:           var(--background);
+  --color-foreground:           var(--foreground);
+  --color-card:                 var(--card);
+  --color-card-foreground:      var(--card-foreground);
+  --color-popover:              var(--popover);
+  --color-popover-foreground:   var(--popover-foreground);
+  --color-primary:              var(--primary);
+  --color-primary-foreground:   var(--primary-foreground);
+  --color-secondary:            var(--secondary);
+  --color-secondary-foreground: var(--secondary-foreground);
+  --color-muted:                var(--muted);
+  --color-muted-foreground:     var(--muted-foreground);
+  --color-accent:               var(--accent);
+  --color-accent-foreground:    var(--accent-foreground);
+  --color-destructive:          var(--destructive);
+  --color-border:               var(--border);
+  --color-input:                var(--input);
+  --color-ring:                 var(--ring);
+  --color-sidebar:              var(--sidebar);
+  --color-sidebar-foreground:   var(--sidebar-foreground);
+  --color-sidebar-border:       var(--sidebar-border);
+  --color-sidebar-accent:       var(--sidebar-accent);
+  --color-sidebar-accent-foreground: var(--sidebar-accent-foreground);
+
+  --color-chart-1: var(--chart-1);
+  --color-chart-2: var(--chart-2);
+  --color-chart-3: var(--chart-3);
+  --color-chart-4: var(--chart-4);
+  --color-chart-5: var(--chart-5);
+
+  --radius-sm:  calc(var(--radius) - 2px);
+  --radius-md:  var(--radius);
+  --radius-lg:  calc(var(--radius) + 2px);
+  --radius-xl:  calc(var(--radius) + 6px);
+}
+
+@custom-variant dark (&:is(.dark *));
+
+/* ── LIGHT ── */
+:root {
+  --background:          oklch(0.962 0.002 247);
+  --foreground:          oklch(0.12 0.010 255);
+
+  --card:                oklch(1 0 0);
+  --card-foreground:     oklch(0.12 0.010 255);
+
+  --popover:             oklch(1 0 0);
+  --popover-foreground:  oklch(0.12 0.010 255);
+
+  --primary:             oklch(0.13 0.012 255);
+  --primary-foreground:  oklch(0.98 0 0);
+
+  --secondary:           oklch(0.95 0.003 247);
+  --secondary-foreground:oklch(0.13 0.012 255);
+
+  --muted:               oklch(0.94 0.003 247);
+  --muted-foreground:    oklch(0.50 0.008 255);
+
+  --accent:              oklch(0.92 0.004 247);
+  --accent-foreground:   oklch(0.13 0.012 255);
+
+  --destructive:         oklch(0.577 0.245 27.325);
+
+  --border:              oklch(0.885 0.004 247);
+  --input:               oklch(0.885 0.004 247);
+  --ring:                oklch(0.50 0.010 255);
+
+  --chart-1:             oklch(0.62 0.17 145);
+  --chart-2:             oklch(0.55 0.20 255);
+  --chart-3:             oklch(0.56 0.24 27);
+  --chart-4:             oklch(0.72 0.16 84);
+  --chart-5:             oklch(0.60 0.19 302);
+
+  --sidebar:             oklch(0.980 0.001 247);
+  --sidebar-foreground:  oklch(0.12 0.010 255);
+  --sidebar-border:      oklch(0.885 0.004 247);
+  --sidebar-accent:      oklch(0.92 0.004 247);
+  --sidebar-accent-foreground: oklch(0.12 0.010 255);
+
+  --radius: 0.5rem;
+}
+
+/* ── DARK ── */
+.dark {
+  --background:          oklch(0.115 0.006 255);
+  --foreground:          oklch(0.94 0.004 255);
+
+  --card:                oklch(0.155 0.006 255);
+  --card-foreground:     oklch(0.94 0.004 255);
+
+  --popover:             oklch(0.175 0.007 255);
+  --popover-foreground:  oklch(0.94 0.004 255);
+
+  --primary:             oklch(0.93 0.003 255);
+  --primary-foreground:  oklch(0.155 0.006 255);
+
+  --secondary:           oklch(0.21 0.007 255);
+  --secondary-foreground:oklch(0.94 0.004 255);
+
+  --muted:               oklch(0.21 0.007 255);
+  --muted-foreground:    oklch(0.54 0.008 255);
+
+  --accent:              oklch(0.24 0.008 255);
+  --accent-foreground:   oklch(0.94 0.004 255);
+
+  --destructive:         oklch(0.65 0.20 22);
+
+  --border:              oklch(1 0 0 / 9%);
+  --input:               oklch(1 0 0 / 11%);
+  --ring:                oklch(0.55 0.008 255);
+
+  --chart-1:             oklch(0.68 0.16 145);
+  --chart-2:             oklch(0.62 0.19 255);
+  --chart-3:             oklch(0.63 0.22 27);
+  --chart-4:             oklch(0.76 0.15 84);
+  --chart-5:             oklch(0.66 0.17 302);
+
+  --sidebar:             oklch(0.138 0.006 255);
+  --sidebar-foreground:  oklch(0.94 0.004 255);
+  --sidebar-border:      oklch(1 0 0 / 8%);
+  --sidebar-accent:      oklch(0.22 0.008 255);
+  --sidebar-accent-foreground: oklch(0.94 0.004 255);
+}
+
+/* ── BASE ── */
+@layer base {
+  * { @apply border-border outline-ring/50; }
+
+  html {
+    @apply font-sans;
+    -webkit-font-smoothing: antialiased;
+    -moz-osx-font-smoothing: grayscale;
+  }
+
+  body {
+    @apply bg-background text-foreground;
+    font-feature-settings: "cv02","cv03","cv04","cv11";
+  }
+
+  ::-webkit-scrollbar        { width: 4px; height: 4px; }
+  ::-webkit-scrollbar-track  { background: transparent; }
+  ::-webkit-scrollbar-thumb  { @apply bg-border rounded-full; }
+  ::-webkit-scrollbar-thumb:hover { @apply bg-muted-foreground/30; }
+}
+
+/* ── UTILITIES ── */
+@layer utilities {
+  .metric-value {
+    @apply text-[26px] font-semibold leading-none tracking-tight tabular-nums;
+  }
+  .metric-label {
+    @apply text-[11px] font-semibold uppercase tracking-widest text-muted-foreground/60;
+  }
+  .pill-green  { @apply inline-flex items-center rounded-full bg-emerald-500/10 px-2 py-0.5 text-[11px] font-medium text-emerald-600 dark:text-emerald-400; }
+  .pill-red    { @apply inline-flex items-center rounded-full bg-red-500/10 px-2 py-0.5 text-[11px] font-medium text-red-600 dark:text-red-400; }
+  .pill-amber  { @apply inline-flex items-center rounded-full bg-amber-500/10 px-2 py-0.5 text-[11px] font-medium text-amber-600 dark:text-amber-400; }
+  .pill-blue   { @apply inline-flex items-center rounded-full bg-blue-500/10 px-2 py-0.5 text-[11px] font-medium text-blue-600 dark:text-blue-400; }
+  .pill-muted  { @apply inline-flex items-center rounded-full bg-muted px-2 py-0.5 text-[11px] font-medium text-muted-foreground; }
+  .tab-btn     { @apply rounded-md px-3 py-1 text-[12px] font-medium transition-all duration-150; }
+  .tab-btn-active  { @apply bg-foreground text-background; }
+  .tab-btn-idle    { @apply text-muted-foreground hover:text-foreground; }
+  .tab-group   { @apply inline-flex items-center rounded-lg border border-border bg-background p-0.5; }
+}
