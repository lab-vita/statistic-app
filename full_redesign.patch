-      <span className="absolute bottom-2 right-3 text-[11px] font-semibold text-primary/60 tabular-nums">
-        {w}×{h}
-      </span>
-    </div>
-  );
-}
-
-// ─ Draggable widget ──────────────────────────────────────────────
-function DraggableWidget({ pw, editMode, onDelete, onResizeStart,
