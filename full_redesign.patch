+  return pct >= 70 ? "bg-emerald-500"
+       : pct >= 40 ? "bg-amber-500"
+       : "bg-red-500";
+}
+
+export function ConversionBlock({ dateFrom, dateTo }: ConversionBlockProps) {
+  const [data, setData]       = useState<ConversionResponse | null>(null);
