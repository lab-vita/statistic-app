# PostgreSQL — asyncpg DSN
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/statistic

# Bitrix24 webhook URL (заканчивается на /)
BITRIX_WEBHOOK_URL=https://your-portal.bitrix24.ru/rest/1/your-token/

# МедОДС
MEDODS_URL=https://labvita.medods.ru
MEDODS_USERNAME=your_username
MEDODS_PASSWORD=your_password
MEDODS_CLINIC_ID=1

# CORS — через запятую, без пробелов
ALLOWED_ORIGINS=http://localhost:3000

# --- Авторизация через Битрикс24 ---
# Локальная разработка: true отключает проверку входа. В продакшене НЕ ставить!
AUTH_DISABLED=true
# Для продакшена:
# BITRIX_PORTAL_DOMAIN=your-portal.bitrix24.ru
# SESSION_SECRET=            # openssl rand -hex 32
# OWNER_BITRIX_USER_ID=      # ваш ID в Битрикс24

# --- Утренняя сводка (настраивается в «Настройках» приложения) ---
# Входящему вебхуку нужны права «Чат-боты (imbot)» и «Чат и уведомления (im)».
# Адрес сервера, на который портал шлёт события бота; пусто → первый https из ALLOWED_ORIGINS
# PUBLIC_URL=https://docs.lab-vita.ru
